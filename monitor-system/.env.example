FLASK_ENV=development
FLASK_APP=app.py
FLASK_RUN_PORT=5001
SECRET_KEY=change-this-in-production
DATABASE_PATH=database/monitor_system.db
LOGS_DIR=logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=2097152
LOG_BACKUP_COUNT=5
ADDRESS_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
MONITORING_SCHEDULER_ENABLED=false
MONITORING_SCHEDULER_CRON=0 2 22-28 * sun
MONITORING_SCHEDULER_TIMEZONE=UTC
AUTO_CREATE_DB_ON_START=true
